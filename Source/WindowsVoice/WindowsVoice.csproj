<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
		<OutputType>Library</OutputType>
		<RootNamespace>KLib.WindowsVoice</RootNamespace>
		<AssemblyName>KLib.WindowsVoice</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="WindowsVoice.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageReference Include="System.Speech" Version="10.0.11" />
	</ItemGroup>
	
	<PropertyGroup>
		<AssemblyTitle>KLib.WindowsVoice</AssemblyTitle>
		<Product>KLib.WindowsVoice</Product>
		<Copyright>Copyright ©  2026</Copyright>
		<AssemblyVersion>1.2</AssemblyVersion>
		<FileVersion>1.2</FileVersion>
		<Version>1.2</Version>
	</PropertyGroup>

	<PropertyGroup>
		<PackageOutputPath>$(DEVROOT)\Packages</PackageOutputPath>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>